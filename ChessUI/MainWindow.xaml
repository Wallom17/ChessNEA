<Window x:Class="ChessUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessUI"
        mc:Ignorable="d"
        Title="ChessYay"  Width="600" SizeToContent="Height"
        Icon="/Assets/Icon.png"
        Background="LightPink">
    
    <Viewbox>
        <Grid x:Name="GridBoard"
              Width="600"
              Height="600"
              MouseDown="GridBoard_MouseDown">
            <Grid.Background>
                <ImageBrush ImageSource="/Assets/Board.png"/>
            </Grid.Background>
            <UniformGrid x:Name="GridHighlights"
                         Rows="8"
                         Columns="8">
            </UniformGrid>
            
            <UniformGrid x:Name="GridPiece"
                         Rows="8"
                         Columns="8"
                         RenderOptions.BitmapScalingMode="HighQuality">
                
            </UniformGrid>
            <Grid x:Name="PromotionPanel"
                  Visibility="Collapsed"
                  Background="#99000000">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="White"
                            Width="180">

                    <TextBlock Text="Promote your pawn"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="10"/>

                    <Button Content="Queen"
                            Click="QueenPromotionButton"
                            Margin="5"/>

                    <Button Content="Rook"
                            Click="RookPromotionButton"
                            Margin="5"/>

                    <Button Content="Bishop"
                            Click="BishopPromotionButton"
                            Margin="5"/>

                    <Button Content="Knight"
                            Click="KnightPromotionButton"
                            Margin="5"/>

                </StackPanel>
            </Grid>
        </Grid>
    </Viewbox>

</Window>
